# Copy this file to ".env" (the setup script does it for you).
PORT=5000
# Use 127.0.0.1 (not "localhost") on Windows to avoid IPv6 connection problems.
MONGODB_URI=mongodb://127.0.0.1:27017/fake_product_db
# JSON-RPC address of the local Hardhat blockchain (npm run node)
RPC_URL=http://127.0.0.1:8545
# Browser address(es) allowed to call this API, comma separated
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# Suspicious-scan rule: flag a product scanned this many times within the window
SUSPICIOUS_SCAN_THRESHOLD=5
SUSPICIOUS_SCAN_WINDOW_MINUTES=10
