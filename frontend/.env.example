# Copy this file to ".env" (the setup script does it for you). Restart `npm run dev` after editing.
# Backend API address - must match PORT in backend/.env
VITE_API_URL=http://localhost:5000/api
# Chain ID of the Hardhat local blockchain
VITE_CHAIN_ID=31337
# Address printed inside the QR code. Leave empty to use the address of the website you are on.
# To scan with a phone on the same Wi-Fi, set it to http://YOUR-PC-IP:5173
VITE_PUBLIC_BASE_URL=
